# ============================================================
# Transcriptor — Environment Configuration
# Copy this to .env and fill in the keys you need.
# ============================================================

# --- Server ---
PORT=8700
# Comma-separated allowed CORS origins (default: http://localhost:8700)
# CORS_ORIGINS=http://localhost:8700
# Max upload size in MB (default: 500)
# MAX_UPLOAD_MB=500

# --- Optional auth ---
# Leave APP_PASSWORD empty to run open (no login).
# If set, the whole app is protected with HTTP Basic auth — the browser shows
# a native login prompt; no login page needed. Put the server behind HTTPS.
APP_USERNAME=admin
APP_PASSWORD=

# --- Soniox (cloud provider) ---
# Get a key at: https://soniox.com/
SONIOX_API_KEY=
# Optional overrides:
# SONIOX_API_URL=https://api.soniox.com      # or https://api.eu.soniox.com
# SONIOX_MODEL=stt-async-v4

# --- Local provider: Parakeet V3 + pyannote (optional) ---
# Requires a SEPARATE Python 3.13 venv with NeMo installed (NeMo is not
# compatible with 3.14). Point this at that interpreter. If unset/missing,
# the local provider self-disables and only the cloud provider is used.
# PARAKEET_PYTHON=~/.local/share/parakeet-venv/bin/python
# PARAKEET_MODEL=nvidia/parakeet-tdt-0.6b-v3
#
# HuggingFace token for speaker diarization (optional, local provider only).
# Get a free read token at https://huggingface.co/settings/tokens and accept:
#   https://huggingface.co/pyannote/segmentation-3.0
#   https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=

# --- Docker secrets (recommended for deployment) ---
# Instead of env vars, create files in secrets/ and the app reads
# /run/secrets/<name> first, falling back to the env var:
#   echo "key-..." > secrets/soniox_api_key
#   echo "hf_..."  > secrets/hf_token
#   echo "mypass"  > secrets/app_password
#   chmod 600 secrets/*

# --- CLI ---
TRANSCRIPTOR_URL=http://localhost:8700
# TRANSCRIPTOR_USERNAME=
# TRANSCRIPTOR_PASSWORD=
